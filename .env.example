# Frontend (Vite). ONLY the project URL and the publishable / anon key belong here.
# NEVER put the service-role / secret key in any VITE_* variable — it would ship to every browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Evidence uploads stay OFF until storage policies are applied AND verified against your project (see docs/SECURITY.md).
VITE_EVIDENCE_UPLOADS_ENABLED=false
